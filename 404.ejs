<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>EduAdmin — 404 Not Found</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>

<div class="not-found-wrap">
  <div>
    <div class="not-found-code">404</div>
    <div style="font-size:4rem; text-align:center; margin:-20px 0 20px;">🔍</div>
    <h2 style="font-family:'Poppins',sans-serif; font-size:1.6rem; font-weight:700; color:#1e293b; text-align:center; margin-bottom:10px;">
      Page Not Found
    </h2>
    <p style="color:#64748b; text-align:center; margin-bottom:30px;">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <div style="text-align:center;">
      <a href="/dashboard" class="btn-add" style="margin:0 auto;">
        <i class="fa fa-gauge"></i> Go to Dashboard
      </a>
    </div>
  </div>
</div>

</body>
</html>
